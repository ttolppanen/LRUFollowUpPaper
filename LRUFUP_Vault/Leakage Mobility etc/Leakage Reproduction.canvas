	"nodes":[
		{"id":"56057ab7110096ab","type":"group","x":-880,"y":560,"width":2080,"height":1040,"color":"3","label":"Randomized Benchmarking With Leakage on Neighboring Site"},
		{"id":"6e613d500839837e","x":440,"y":2660,"width":1640,"height":881,"color":"3","type":"group","label":"RB With Qubits Reversed (In frequency)"},
		{"id":"23cee119ea6bf4b1","type":"text","text":"# What processes can replicate/create new leakage?","x":-320,"y":-180,"width":309,"height":160,"color":"1"},
		{"id":"8a6f44d4da154d72","type":"text","text":"Single excitation on neighboring site","x":-480,"y":1051,"width":167,"height":100},
		{"id":"b6c1dde790347dc6","type":"text","text":"Empty second site","x":-480,"y":784,"width":180,"height":60},
