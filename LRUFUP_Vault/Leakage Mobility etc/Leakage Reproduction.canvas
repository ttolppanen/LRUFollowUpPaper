		{"id":"6d83d4504bad36e8","type":"file","file":"Data/LRU/CLRU/LeakageStarkShift/WithRB/with_leakage.png","x":160,"y":1275,"width":400,"height":267},
		{"id":"b378be3b219cba7f","type":"file","file":"Data/LRU/CLRU/LeakageStarkShift/WithRB/boson_number_with_leakage.png","x":600,"y":1275,"width":400,"height":267},
		{"id":"8f2869eb8463a376","type":"text","text":"It seems like leakage can cause more leakage generation with single qubit gates.","x":45,"y":1957,"width":235,"height":123,"color":"4"},
		{"id":"a323395b1c38b910","type":"file","file":"Data/LRU/CLRU/LeakageStarkShift/WithRB/SitesReversed/anh_without_leakage.png","x":1240,"y":2680,"width":400,"height":267},
		{"id":"b2ef845c716c9641","type":"file","file":"Data/LRU/CLRU/LeakageStarkShift/WithRB/SitesReversed/anh_with_single.png","x":1240,"y":2967,"width":400,"height":267},
		{"id":"68ae90df3cd07c68","type":"file","file":"Data/LRU/CLRU/LeakageStarkShift/WithRB/SitesReversed/anh_with_leakage.png","x":1240,"y":3254,"width":400,"height":267},
