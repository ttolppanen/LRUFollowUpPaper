		{"id":"8386cf5bb0e38656","type":"text","text":"First qubit subspace","x":-205,"y":580,"width":250,"height":60},
		{"id":"1fec4437a35d0783","type":"file","file":"Data/LRU/CLRU/LeakageStarkShift/WithRB/subspace_with_single.png","x":-280,"y":967,"width":400,"height":267},
