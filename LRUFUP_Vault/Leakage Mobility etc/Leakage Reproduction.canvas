		{"id":"98ab521a621e6a9d","type":"file","file":"Data/LRU/CLRU/LeakageStarkShift/WithRB/boson_number_without_leakage.png","x":600,"y":660,"width":400,"height":267},
		{"id":"895f8c873951208f","type":"text","text":"Total boson number","x":675,"y":580,"width":250,"height":60},
		{"id":"5459767faf5e52d5","type":"text","text":"Can leakage cause Stark shift, and thus make single qubit gates operate non-optimally and cause more leakage generation?","x":-313,"y":180,"width":297,"height":150,"color":"1"},
		{"id":"8e92a6c7e416afbe","type":"text","text":"Leakage on neighboring site","x":-480,"y":1347,"width":175,"height":82},
